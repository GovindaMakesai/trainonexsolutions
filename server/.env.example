NODE_ENV=development
PORT=5000

# MongoDB Atlas or local MongoDB. Do not commit the real value.
MONGODB_URI=mongodb://127.0.0.1:27017/trainonex

# At least 32 random characters. Example generation:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# Public site origin. Comma-separate multiple origins if needed. No trailing slash.
CLIENT_URL=http://localhost:5173

# Public URL of this API, used for locally stored images in development.
SERVER_URL=http://localhost:5000

# Cloudinary. Required for persistent images on Render. Leave blank in local dev
# to store uploads in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only when no admin document exists yet. Never commit a real .env.
ADMIN_NAME=Trainonex Admin
ADMIN_EMAIL=admin@trainonex.com
ADMIN_PASSWORD=replace-with-a-strong-password
